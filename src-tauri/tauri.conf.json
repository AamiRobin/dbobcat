{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBobcat",
  "version": "0.1.0-alpha.1",
  "identifier": "app.dbobcat.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DBobcat",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 23 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg", "app"],
    "publisher": "Amir Robin",
    "copyright": "© 2026 Amir Robin — MIT licensed",
    "category": "DeveloperTool",
    "homepage": "https://github.com/AamiRobin/dbobcat",
    "shortDescription": "Open-source database GUI client",
    "longDescription": "DBobcat is an open-source, cross-platform database GUI client for MySQL/MariaDB, PostgreSQL, and SQLite. It offers a session manager with SSH tunnels and encrypted password storage, a virtualized data grid with change posting, a SQL editor with schema-driven completion, a table designer with ALTER preview, export/import across many formats, and server administration tools.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
